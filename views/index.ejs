<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= site.title %></title>
<meta name="description" content="<%= site.description %>">
<link rel="canonical" href="<%= site.url %>/">
<meta name="theme-color" content="#0d0f12">
<meta property="og:type" content="website">
<meta property="og:title" content="YUSUF TECH — Web Developer for Businesses & Professionals">
<meta property="og:description" content="Professional websites, SEO optimization and digital advertising for cafés, laundries, law firms, real estate agencies, schools, and personal brands — by YUSUF TECH.">
<meta property="og:image" content="<%= site.ogImage %>">
<meta property="og:url" content="<%= site.url %>/">
<meta property="og:site_name" content="YUSUF TECH">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="<%= site.logo %>">
<link rel="apple-touch-icon" href="<%= site.logo %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@500;600;700;800&display=swap">
<script src="/js/theme.js"></script>
<link rel="stylesheet" href="/css/style.css">
<script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"ProfessionalService","name":site.brand,"url":site.url,"description":site.description,"email":site.email,"areaServed":"Worldwide","sameAs":site.socials.filter(s=>s.url.startsWith("http")).map(s=>s.url)}).replace(/</g,"\\u003c") %></script>
<script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":site.faqs.map(f=>({"@type":"Question","name":f[0],"acceptedAnswer":{"@type":"Answer","text":f[1]}}))}).replace(/</g,"\\u003c") %></script>
</head>
<body id="top">
<div class="loader-wrap" id="loader" role="status" aria-label="Loading">
  <div class="loader"><div class="circle"></div><div class="circle"></div><div class="circle"></div><div class="circle"></div></div>
</div>
<noscript><style>#loader{display:none}</style></noscript>

<div class="progress" id="progress" aria-hidden="true"></div>
<header class="nav">
  <div class="wrap nav-in">
    <a href="#top" class="brand"><img class="mark" src="<%= site.logo %>" alt="" width="38" height="38"><b>YUSUF<span>TECH</span></b></a>
    <nav id="menu" aria-label="Main">
      <a href="#about">About</a><a href="#services">Services</a><a href="#marketing">Marketing</a><a href="#work">Work</a><a href="#pricing">Pricing</a><a href="#faq">FAQ</a><a href="#contact">Contact</a>
    </nav>
    <a href="#contact" class="btn btn-amber nav-cta">Start a project</a>
    <button class="theme-toggle" id="theme" type="button" aria-label="Switch to light mode"><span class="ico-moon"><%- glyph("moon") %></span><span class="ico-sun"><%- glyph("sun") %></span></button>
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="menu"><i></i><i></i></button>
  </div>
</header>

<main>
<div class="hero-bg" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="gridbg"></span></div>
<section class="hero wrap">
  <div class="hero-copy">
    <p class="status"><span class="dot"></span>Taking new projects</p>
    <h1>Websites that make your <span class="rot" id="rot" data-words="business,café,law firm,school,brand,laundry">business</span> look like it has already made it.</h1>
    <p class="lead">I design, build, and deploy professional websites for real businesses, from a café menu page to a law firm's practice site to a full school website. Clean, fast, mobile-first, and live on your own domain.</p>
    <div class="actions"><a href="#work" class="btn btn-amber">See my work</a><a href="#contact" class="btn btn-ghost">Get a website for my business</a></div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="mock">
      <div class="mock-bar"><span class="dots"></span><em>yourbusiness.com</em></div>
      <div class="mock-body">
        <div class="mock-nav"><b></b><span></span><span></span><span></span></div>
        <div class="mock-hero"><div class="mock-txt"><i class="l1"></i><i class="l2"></i><i class="l3"></i><u></u></div><div class="mock-img"></div></div>
        <div class="mock-cards"><div></div><div></div><div></div></div>
      </div>
    </div>
    <div class="float f1"><%- glyph("phone") %><span>Mobile-first</span></div>
    <div class="float f2"><%- glyph("search") %><span>SEO-ready</span></div>
    <div class="float f3"><%- glyph("bolt") %><span>Live in ~24h</span></div>
  </div>
</section>

<section class="wrap statband">
  <dl class="stats">
    <% site.stats.forEach(s => { const m = String(s[0]).match(/^([\d.]+)(.*)$/); %>
    <div><dt><%= s[1] %></dt><dd><% if (m) { %><span class="count" data-to="<%= m[1] %>" data-dec="<%= (m[1].split('.')[1] || '').length %>"><%= m[1] %></span><%= m[2] %><% } else { %><%= s[0] %><% } %></dd></div><% }) %>
    <div><dt>Live websites</dt><dd><span class="count" data-to="<%= site.projects.length %>" data-dec="0"><%= site.projects.length %></span></dd></div>
  </dl>
</section>

<div class="marquee" aria-label="Industries and projects">
  <div class="marquee-track">
    <% for (let k = 0; k < 2; k++) { %><ul <%- k ? 'aria-hidden="true"' : '' %>><% site.industries.concat(site.projects.map(p => p.name)).forEach(i => { %><li><%= i %></li><% }) %></ul><% } %>
  </div>
</div>

<section class="sec wrap split" id="about" data-n="01">
  <div class="photo"><img src="<%= site.photo %>" alt="Yusuf, founder and developer at YUSUF TECH" width="420" height="420" loading="lazy"></div>
  <div class="prose"><h2>Hi, I'm Yusuf.</h2><% site.about.forEach(p => { %><p><%= p %></p><% }) %></div>
</section>

<section class="sec wrap alt" id="services" data-n="02">
  <h2>Who I build for</h2>
  <p class="sub">Every business is different. The website shouldn't look like it isn't.</p>
  <div class="grid3 bento"><% site.services.forEach((s, i) => { %><article class="card"><span class="gi"><%- glyph(site.serviceIcons[i]) %></span><h3><%= s[0] %></h3><p><%= s[1] %></p></article><% }) %></div>
</section>

<section class="sec wrap mesh" id="marketing" data-n="03">
  <p class="kicker"><%= site.marketing.kicker %></p>
  <h2><%= site.marketing.title %></h2>
  <div class="prose mk-intro"><% site.marketing.intro.forEach(p => { %><p><%= p %></p><% }) %></div>

  <h3 class="mk-h"><%= site.marketing.servicesTitle %></h3>
  <div class="grid2"><% site.marketing.services.forEach((m, mi) => { %>
    <article class="card mk">
      <div class="mk-vis" aria-hidden="true">
      <% if (mi === 0) { %>
        <div class="serp">
          <div class="serp-q"><%- glyph("search") %><span>best service near me</span></div>
          <div class="serp-r"><small>www.yourbusiness.com</small><b>Your Business | Trusted Local Service</b><p>Clear meta title, helpful description and fast pages that help customers find you.</p></div>
          <svg class="trend" viewBox="0 0 200 60" preserveAspectRatio="none"><polyline points="0,52 30,46 60,48 90,34 120,30 150,18 200,6"/></svg>
        </div>
      <% } else { %>
        <div class="ad">
          <div class="ad-card"><small>Sponsored</small><b>Fresh. Fast. Close to you.</b><span class="ad-btn">Learn more</span></div>
          <div class="ad-tags"><span>Local audience</span><span>Interests</span><span>Ages 18–45</span></div>
          <div class="bars"><i></i><i></i><i></i><i></i><i></i></div>
        </div>
      <% } %>
      </div>
      <div class="mk-head"><span class="gi"><%- glyph(mi === 0 ? "search" : "megaphone") %></span><span class="n"><%= m.n %></span></div>
      <h3><%= m.name %></h3>
      <p class="mk-tag"><%= m.tag %></p>
      <p><%= m.desc %></p>
      <h4>What we offer</h4>
      <ul class="ticks"><% m.items.forEach(i => { %><li><%= i %></li><% }) %></ul>
    </article><% }) %>
  </div>

  <h3 class="mk-h"><%= site.marketing.whyTitle %></h3>
  <ul class="chips mk-why"><% site.marketing.why.forEach(w => { %><li><%= w %></li><% }) %></ul>

  <h3 class="mk-h"><%= site.marketing.processTitle %></h3>
  <ol class="grid4 steps"><% site.marketing.process.forEach((p, i) => { %><li class="card"><span class="n">0<%= i + 1 %></span><h3><%= p[0] %></h3><p><%= p[1] %></p></li><% }) %></ol>

  <div class="mk-cta">
    <h3><%= site.marketing.ctaTitle %></h3>
    <% site.marketing.ctaText.forEach(t => { %><p><%= t %></p><% }) %>
    <div class="actions"><a href="#contact" class="btn btn-amber"><%= site.marketing.ctaButton %></a></div>
    <p class="mk-site"><%= site.marketing.ctaSite %></p>
    <p class="mk-brand"><%= site.marketing.tagline %></p>
  </div>
</section>

<section class="sec wrap alt" id="work" data-n="04">
  <h2>Featured work</h2>
  <p class="sub"><%= site.projects.length %> live sites across five industries. Each one is a real, working site.</p>
  <div class="filters" role="group" aria-label="Filter projects">
    <button class="on" data-f="all">All</button><% site.categories.forEach(c => { %><button data-f="<%= c %>"><%= c %></button><% }) %>
  </div>
  <div class="gal-nav"><span>Swipe or drag to browse</span><button type="button" id="gprev" aria-label="Previous projects">&larr;</button><button type="button" id="gnext" aria-label="Next projects">&rarr;</button></div>
  <div class="grid3 gallery" id="projects">
    <% site.projects.forEach(p => { %>
    <a class="proj" data-cat="<%= p.cat %>" href="<%= p.url %>" target="_blank" rel="noopener">
      <span class="thumb" data-g1="<%= p.grad[0] %>" data-g2="<%= p.grad[1] %>"><span class="bar"><span class="dots"></span><em><%= p.url.startsWith("http") ? new URL(p.url).hostname : new URL(site.url).hostname.replace(/^www\./, "") + p.url.replace(/\/$/, "") %></em></span><img src="<%= p.shot %>" alt="Preview of <%= p.name %>" loading="lazy" width="700" height="440"><i><%= p.ini %></i><span class="ov">View live site <%- glyph("arrow") %></span></span>
      <h3><%= p.name %></h3>
      <p><%= p.desc %></p>
      <small><%= p.city %> · <%= p.stack %></small>
      <b>View live</b>
    </a><% }) %>
  </div>
</section>

<section class="sec wrap" id="pricing" data-n="05">
  <h2>How it works</h2>
  <ol class="grid4 steps"><% site.process.forEach((p, i) => { %><li class="card"><span class="n"><%= i + 1 %></span><h3><%= p[0] %></h3><p><%= p[1] %></p></li><% }) %></ol>
  <h2 class="gap">Packages</h2>
  <p class="sub">Every project is quoted to its scope. These are the starting points.</p>
  <div class="grid3"><% site.packages.forEach(k => { %>
    <article class="card pkg<%= k.featured ? ' feat' : '' %>">
      <h3><%= k.name %></h3>
      <p class="price"><%= k.price || "Get a quote" %></p>
      <p><%= k.note %></p>
      <ul><% k.items.forEach(i => { %><li><%= i %></li><% }) %></ul>
      <a href="#contact" class="btn <%= k.featured ? 'btn-amber' : 'btn-ghost' %>">Request a quote</a>
    </article><% }) %>
  </div>
</section>

<section class="sec wrap alt" id="skills" data-n="06">
  <h2>Skills & tools</h2>
  <div class="skills"><% site.skills.forEach(g => { %><div><h3><%= g[0] %></h3><ul><% g[1].forEach(i => { %><li><%= i %></li><% }) %></ul></div><% }) %></div>
</section>

<section class="sec wrap" id="why" data-n="07">
  <h2>Why work with me</h2>
  <div class="grid3"><% site.why.forEach((w, i) => { %><article class="card"><span class="gi"><%- glyph(site.whyIcons[i]) %></span><h3><%= w[0] %></h3><p><%= w[1] %></p></article><% }) %></div>
</section>

<% if (site.testimonials && site.testimonials.length) { %>
<section class="sec wrap" id="proof">
  <h2>What clients say</h2>
  <div class="grid3"><% site.testimonials.forEach(t => { %><figure class="card quote"><blockquote><%= t.quote %></blockquote><figcaption><b><%= t.name %></b><span><%= t.role %></span></figcaption></figure><% }) %></div>
</section>
<% } %>

<section class="sec wrap alt" id="faq" data-n="08">
  <h2>Questions people ask</h2>
  <div class="faq"><% site.faqs.forEach(f => { %><details><summary><%= f[0] %></summary><p><%= f[1] %></p></details><% }) %></div>
</section>

<section class="sec wrap split pop" id="contact" data-n="09">
  <div>
    <h2>Tell me what you run. I'll tell you what it needs.</h2>
    <p class="lead">Café, laundry, law firm, agency, school, or your own name. If it needs a website that represents it properly, that's what I build.</p>
    <ul class="socials"><% site.socials.slice(0, 4).forEach(s => { %><li><a class="soc" href="<%= s.url %>" aria-label="<%= s.label %>" title="<%= s.label %>" <% if (s.url.startsWith("http")) { %>target="_blank" rel="noopener"<% } %>><%- icon(s.id) %></a></li><% }) %></ul>
  </div>
  <form id="form" class="form" novalidate>
    <label>Name<input name="name" autocomplete="name" required minlength="2" maxlength="80"></label>
    <label>Email<input name="email" type="email" autocomplete="email" required maxlength="120"></label>
    <label>What do you need?
      <select name="type" id="type" required><option value="" disabled selected>Choose one</option><% site.projectTypes.forEach(t => { %><option><%= t %></option><% }) %></select>
    </label>
    <label id="otherWrap" hidden>What kind of website?<input name="other" id="other" maxlength="80" placeholder="e.g. church, NGO, event page"></label>
    <label>Tell me more about your project<textarea name="message" rows="5" required minlength="10" maxlength="2000" placeholder="What does your business do, what pages do you need, and when do you need it?"></textarea></label>
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn btn-amber" type="submit">Send message</button>
    <p id="msg" role="status" aria-live="polite"></p>
  </form>
</section>
</main>

<footer class="foot"><div class="wrap foot-in">
  <p>© <%= new Date().getFullYear() %> YUSUF TECH. All rights reserved.</p>
  <ul class="socials"><% site.socials.forEach(s => { %><li><a class="soc sm" href="<%= s.url %>" aria-label="<%= s.label %>" title="<%= s.label %>" <% if (s.url.startsWith("http")) { %>target="_blank" rel="noopener"<% } %>><%- icon(s.id) %></a></li><% }) %></ul>
</div></footer>

<a class="fab" href="<%= site.socials[0].url %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><%- icon("whatsapp") %></a>
<script src="/js/analytics.js"></script>
<script defer src="/_vercel/insights/script.js"></script>
<script src="/js/main.js" defer></script>
</body>
</html>